# Copy to .env (scripts/secrets.ps1 does this for you and fills random passwords).
# .env is gitignored - never commit real passwords.

# PostgreSQL (CloudNativePG) - application user and database "app"
POSTGRES_USER=app
POSTGRES_PASSWORD=change-me

# MongoDB root user
MONGO_ROOT_USER=root
MONGO_ROOT_PASSWORD=change-me

# Redis
REDIS_PASSWORD=change-me

# pgAdmin login (email must look like a real address)
PGADMIN_EMAIL=admin@olympus.dev
PGADMIN_PASSWORD=change-me

# mongo-express basic-auth login
MONGO_EXPRESS_USER=admin
MONGO_EXPRESS_PASSWORD=change-me

# RustFS (S3 object storage) - also the web console login at http://s3.localtest.me
S3_ACCESS_KEY=change-me
S3_SECRET_KEY=change-me

# hermes-audiobooks-api - PostgreSQL role/database "hermes"
HERMES_DB_PASSWORD=change-me
